require "json"
require "uuid"
require "uuid/json"

require "./base/model"

module PlaceOS::Model
  # Unified change history for models that include `History::Tracked`.
  #
  # Entries are written in the same transaction as the change they describe.
  # Filter by `resource_type` (the table name) and `resource_id`, or by
  # `correlation_id` to see changes recorded against a parent, e.g. every
  # permission change of a group.
  class History < ::PgORM::Base
    include Neuroplastic

    Log = ::Log.for(self)

    table :history

    default_primary_key id : UUID, autogenerated: true

    attribute resource_type : String, es_subfield: "keyword"
    attribute resource_id : String, es_subfield: "keyword"
    attribute correlation_id : String?, es_subfield: "keyword"

    # create, update, delete, approve or restore
    attribute action : String, es_subfield: "keyword"
    attribute changed_fields : Array(String) = [] of String, es_type: "keyword"

    # `{"field": [previous, current]}` of the persisted changes
    attribute diff : JSON::Any = JSON::Any.new({} of String => JSON::Any), es_ignore: true

    # the full record, for deletes (see `History::Tracked.undelete`) and approvals.
    # NOTE:: pg-orm reads a NULL column as `JSON::Any(nil)`
    attribute snapshot : JSON::Any? = nil, es_ignore: true

    attribute user_id : String?, es_subfield: "keyword"
    attribute user_email : String?, es_subfield: "keyword"

    # request details, see `History::Metadata`
    attribute context : JSON::Any = JSON::Any.new({} of String => JSON::Any), es_ignore: true

    attribute created_at : Time = -> { Time.utc }, converter: PlaceOS::Model::Timestamps::EpochConverter, type: "integer", format: "Int64"

    validates :resource_type, presence: true
    validates :resource_id, presence: true
    validates :action, presence: true

    # Entries of a resource, newest first
    def self.for_resource(resource_type : String, resource_id : String)
      where(resource_type: resource_type, resource_id: resource_id).order(created_at: :desc, id: :desc)
    end

    # Entries recorded against a parent, newest first
    def self.correlated(correlation_id : String)
      where(correlation_id: correlation_id).order(created_at: :desc, id: :desc)
    end

    def metadata : Metadata
      Metadata.from_json(context.to_json)
    end

    # Request context
    ###############################################################################################

    # Details of who made a change and from where, recorded with each entry.
    #
    # Set for the current fiber with `History.with_metadata` (rest-api does
    # this for each request) or per record with `Tracked#history_metadata=`.
    record Metadata,
      user_id : String? = nil,
      user_email : String? = nil,
      user_name : String? = nil,
      api_key_id : String? = nil,
      api_key_name : String? = nil,
      app_id : String? = nil,
      app_name : String? = nil,
      app_date : String? = nil,
      app_build : String? = nil,
      user_agent : String? = nil,
      ip : String? = nil,
      request_id : String? = nil do
      include JSON::Serializable

      # Copy of this metadata attributed to `user`
      def with_user(user) : Metadata
        copy_with(user_id: user.id, user_email: user.email.to_s, user_name: user.name)
      end
    end

    # Builds metadata on demand, see `with_metadata`
    alias MetadataProvider = Proc(Metadata)

    @@fiber_metadata = {} of UInt64 => Metadata | MetadataProvider
    @@fiber_metadata_lock = Mutex.new

    # Metadata of the current fiber, see `with_metadata`
    def self.current_metadata : Metadata?
      case value = @@fiber_metadata_lock.synchronize { @@fiber_metadata[Fiber.current.object_id]? }
      in Metadata         then value
      in MetadataProvider then value.call
      in Nil              then nil
      end
    end

    # Attributes changes made by the block, including those of cascading
    # callbacks, to `metadata`. A `MetadataProvider` is only called when a
    # change is recorded, so it can depend on state set within the block, such
    # as the user once a request has been authenticated.
    def self.with_metadata(metadata : Metadata | MetadataProvider | Nil, &)
      fiber_id = Fiber.current.object_id
      previous = @@fiber_metadata_lock.synchronize { @@fiber_metadata[fiber_id]? }
      set_fiber_metadata(fiber_id, metadata)
      begin
        yield
      ensure
        set_fiber_metadata(fiber_id, previous)
      end
    end

    private def self.set_fiber_metadata(fiber_id : UInt64, metadata : Metadata | MetadataProvider | Nil) : Nil
      @@fiber_metadata_lock.synchronize do
        if metadata
          @@fiber_metadata[fiber_id] = metadata
        else
          @@fiber_metadata.delete(fiber_id)
        end
      end
    end

    # Retention
    ###############################################################################################

    # Per resource, entries within `retention` are kept up to `max_entries`.
    # Older entries are removed, except for the newest `min_entries`, which
    # are kept until the resource has been deleted for longer than `retention`.
    class_property retention : Time::Span = (ENV["PLACE_HISTORY_RETENTION_DAYS"]?.try(&.to_i?) || 30).days
    class_property max_entries : Int32 = ENV["PLACE_HISTORY_MAX_ENTRIES"]?.try(&.to_i?) || 250
    class_property min_entries : Int32 = ENV["PLACE_HISTORY_MIN_ENTRIES"]?.try(&.to_i?) || 5

    # How often `cleanup_expired` runs as entries are recorded, nil disables it
    class_property cleanup_interval : Time::Span? = 1.hour
    class_property cleanup_batch : Int32 = 1000

    @@last_cleanup : Time? = nil

    # Records a change, then applies the retention policy
    def self.record_change(
      resource_type : String,
      resource_id : String,
      action : String,
      correlation_id : String? = nil,
      diff : Hash(String, JSON::Any) = {} of String => JSON::Any,
      changed_fields : Array(String) = diff.keys,
      snapshot : JSON::Any? = nil,
      metadata : Metadata? = nil,
    ) : History
      metadata ||= current_metadata
      entry = create!(
        resource_type: resource_type,
        resource_id: resource_id,
        correlation_id: correlation_id,
        action: action,
        changed_fields: changed_fields,
        diff: JSON::Any.new(diff),
        snapshot: snapshot,
        user_id: metadata.try(&.user_id),
        user_email: metadata.try(&.user_email),
        context: metadata ? JSON.parse(metadata.to_json) : JSON::Any.new({} of String => JSON::Any),
      )
      trim(resource_type, resource_id)
      cleanup_periodically
      entry
    end

    # Applies the retention policy to a single resource
    def self.trim(resource_type : String, resource_id : String) : Nil
      ::PgORM::Database.connection &.exec(<<-SQL, resource_type, resource_id, max_entries, min_entries, Time.utc - retention)
        DELETE FROM history WHERE id IN (
          SELECT id FROM (
            SELECT id, created_at, row_number() OVER (ORDER BY created_at DESC, id DESC) AS position
            FROM history
            WHERE resource_type = $1 AND resource_id = $2
          ) ranked
          WHERE position > $3 OR (position > $4 AND created_at < $5)
        )
      SQL
    end

    # Removes expired entries across all resources, in batches of `limit`.
    #
    # Entries older than `retention` are removed beyond the newest
    # `min_entries` of each resource, or entirely once the resource was
    # deleted longer than `retention` ago. Returns the number removed.
    def self.cleanup_expired(limit : Int32 = cleanup_batch) : Int32
      cutoff = Time.utc - retention
      result = ::PgORM::Database.connection &.exec(<<-SQL, cutoff, min_entries, limit)
        DELETE FROM history WHERE id IN (
          SELECT h.id FROM history h
          LEFT JOIN LATERAL (
            SELECT l.action, l.created_at FROM history l
            WHERE l.resource_type = h.resource_type AND l.resource_id = h.resource_id
            ORDER BY l.created_at DESC, l.id DESC
            LIMIT 1
          ) latest ON TRUE
          WHERE h.created_at < $1
            AND (
              (latest.action = 'delete' AND latest.created_at < $1)
              OR $2 <= 0
              OR EXISTS (
                SELECT 1 FROM history n
                WHERE n.resource_type = h.resource_type AND n.resource_id = h.resource_id
                  AND (n.created_at, n.id) > (h.created_at, h.id)
                OFFSET GREATEST($2 - 1, 0) LIMIT 1
              )
            )
          ORDER BY h.created_at
          LIMIT $3
        )
      SQL
      result.rows_affected.to_i
    end

    # Housekeeping is never worth failing a change over, so this runs in a
    # savepoint and failures are logged
    private def self.cleanup_periodically : Nil
      interval = cleanup_interval
      return unless interval
      now = Time.utc
      if last = @@last_cleanup
        return if (now - last) < interval
      end
      @@last_cleanup = now

      begin
        ::PgORM::Database.transaction do
          removed = cleanup_expired
          Log.info { {message: "history cleaned up", removed: removed} } if removed > 0
        end
      rescue ex
        Log.warn(exception: ex) { "history cleanup failed" }
      end
    end
  end
end

require "./history/tracked"
