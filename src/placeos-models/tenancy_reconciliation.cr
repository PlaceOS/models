require "json"
require "uuid"
require "uuid/json"

require "./base/model"

module PlaceOS::Model
  # Durable reconciliation results and idempotency receipts. These records are
  # independent of History retention and preserve deleted actor/credential IDs.
  class TenancyReconciliation < ::PgORM::Base
    table :tenancy_reconciliations

    default_primary_key id : UUID, autogenerated: true

    attribute actor_id : String
    attribute authority_id : String
    attribute api_key_id : String?
    attribute idempotency_key : String
    attribute digest : String
    attribute plan : JSON::Any = JSON::Any.new({} of String => JSON::Any)
    attribute result : JSON::Any = JSON::Any.new({} of String => JSON::Any)
    attribute created_at : Time = -> { Time.utc }, converter: PlaceOS::Model::Timestamps::EpochConverter

    validates :actor_id, presence: true
    validates :authority_id, presence: true
    validates :idempotency_key, presence: true
    validates :digest, presence: true
  end
end
